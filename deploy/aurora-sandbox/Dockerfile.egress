# Minimal Aurora egress proxy image.
#
# Final image contract: only the static Go proxy binary and the CA bundle, run
# as UID/GID 10001:10001 with the fixed proxy command. No shell, package
# manager, download client, or secret.
#
# The Go module arrives through the Bake named context `server`; the image
# context is deploy/aurora-sandbox, whose .dockerignore is deny-all.
FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS proxybuilder
ARG TARGETARCH
ARG SOURCE_DATE_EPOCH=0
WORKDIR /src/server
COPY --from=server . /src/server/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH \
      go build -trimpath -buildvcs=false \
      -ldflags="-s -w -buildid=" \
      -o /out/aurora-egress-proxy ./cmd/aurora-egress-proxy

FROM scratch AS egress
COPY --from=proxybuilder /out/aurora-egress-proxy /usr/local/bin/aurora-egress-proxy
# The Debian builder ships the CA bundle; a scratch image carries no other file.
COPY --from=proxybuilder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/aurora-egress-proxy"]
CMD []
