# multica-aurora-sandbox: AppArmor profile for Aurora workspace sandbox
# containers. AppArmor file rules are default-deny, so this profile grants only
# the image's executables/libraries, the writable tmpfs surfaces, the fixed Fleet
# node layout (/data read-write, /secrets read-only), and the read-only
# enrollment/provider secret files, and explicitly denies raw networking, process
# memory, kernel/sysfs writes, and Docker socket paths.
# Mounts are owned by the seccomp KILL_PROCESS rules, not this profile. A
# blanket `deny /**` rule must NOT be used here: an AppArmor deny
# overrides the matching allow rules, including the writable tmpfs surfaces and
# the execute permission the container's own init needs.
#
# Deploy (Linux only): apparmor_parser -Q validates the profile syntax, then
#   apparmor_parser -r multica-aurora-sandbox.apparmor
# Docker references it via --security-opt apparmor=multica-aurora-sandbox.

#include <tunables/global>

profile multica-aurora-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/consoles>

  # ---- Network: no raw or packet sockets; only stream/datagram via the
  # workspace-internal network through the egress sidecar.
  deny network raw,
  deny network packet,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink stream,
  network unix stream,
  network unix dgram,

  # ---- Mount: owned by the seccomp profile, not AppArmor. seccomp.json's
  # leading SCMP_ACT_KILL_PROCESS rules terminate mount, umount, pivot_root, and
  # the rest of the mount syscall family at syscall entry, before Linux can run
  # this AppArmor hook. An AppArmor mount deny could therefore only ever be an
  # unobservable duplicate of a weaker action, so the single owner is
  # deploy/aurora-sandbox/seccomp.json. Do not add a mount rule back here.

  # ---- Process memory and tracing.
  deny /proc/*/mem rwklx,
  deny /proc/*/memory rwklx,
  deny ptrace (read, tracedby, readby),

  # ---- Kernel and sysfs writes.
  deny /sys/** wklx,
  deny /proc/sys/** wklx,
  deny /proc/latency_trace rwklx,
  deny /proc/kcore rwklx,
  deny /proc/kmsg rwklx,
  deny /proc/sysrq-trigger rwklx,

  # ---- Docker socket: the sandbox never reaches the host daemon.
  deny /var/run/docker.sock rwklx,
  deny /run/docker.sock rwklx,
  deny /run/docker/** rwklx,

  # The fixed Fleet node layout (server/internal/fleet/model/aurora.go and
  # model/layout.go): the Fleet mounts the node data volume read-write at /data
  # and the secrets volume read-only at /secrets. The node owns /data and writes
  # its home, workspaces and layout manifest there. The only secret it may read
  # is the single-use enrollment file at its fixed runtime path; a directory rule
  # is the trailing-slash form needed for listing.
  /data rwk,
  /data/ rwk,
  /data/** rwk,
  /secrets r,
  /secrets/ r,
  /secrets/aurora-enrollment r,

  # Legacy secret files staged by the pre-Fleet controller. They stay permitted
  # for deployments that still mount the old shape; the Fleet layout above is the
  # contract the image actually ships.
  /run/secrets/aurora-enrollment r,
  /run/secrets/aurora-provider-* r,

  # Writable tmpfs surfaces only (mounted nosuid,nodev,noexec by the run
  # policy): workspace scratch, /tmp, and /run.
  /tmp/** rwk,
  /run/** rwk,
  /workspace/** rwk,

  # The root filesystem is read-only; allow reading, mapping, and inheriting
  # into the image's own executables and libraries, nothing else. `ix` keeps a
  # child inside this profile rather than escaping to unconfined, and the
  # root-owned read-only image means only trusted content can be executed.
  # The --init runtime binary is mounted by the run policy and may appear under
  # /dev/init or /{,usr/}sbin/docker-init depending on the engine.
  /dev/init ix,
  /{,usr/}bin/** mr,
  /{,usr/}bin/** ix,
  /{,usr/}sbin/** mr,
  /{,usr/}sbin/** ix,
  /usr/local/** mr,
  /usr/local/** ix,
  /usr/lib/** mr,
  /usr/lib/** ix,
  /usr/libexec/** mr,
  /usr/libexec/** ix,
  /lib/** mr,
  /lib/** ix,
  /opt/** mr,
  /opt/** ix,
  /etc/** r,
  /usr/share/** r,

  # Deny capability-relevant sysfs/debugfs exposure outright.
  deny /sys/kernel/debug/** rwklx,
  deny /sys/fs/cgroup/** wklx,
  deny /sys/firmware/** rwklx,
}
